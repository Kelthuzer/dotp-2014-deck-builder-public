<Window x:Class="DeckBuilder.Modern.CardReferenceScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Card reference scanner" Width="1220" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Card reference scanner" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="WorkspaceText" Margin="0,4,0,10" Foreground="#FF555555" TextWrapping="Wrap" />
      <WrapPanel Margin="0,0,0,10">
        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox x:Name="FilterBox" Width="210">
          <ComboBoxItem Content="All cards" IsSelected="True" />
          <ComboBoxItem Content="All tokens" />
          <ComboBoxItem Content="Used tokens" />
          <ComboBoxItem Content="Orphan tokens" />
          <ComboBoxItem Content="Missing art — all cards" />
          <ComboBoxItem Content="Used + missing art" />
        </ComboBox>
        <TextBox x:Name="SearchBox" Width="260" Margin="12,0,0,0" ToolTip="Filter by filename, art id, source or Used by" />
        <Button Content="Rescan" Margin="12,0,0,0" Click="Rescan_Click" />
      </WrapPanel>
      <TextBlock x:Name="SummaryText" Margin="0,0,0,8" />
    </StackPanel>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready" /></StatusBarItem>
    </StatusBar>

    <DataGrid x:Name="ResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Card" Binding="{Binding FileName}" Width="2*" />
        <DataGridCheckBoxColumn Header="Token" Binding="{Binding IsToken}" Width="60" />
        <DataGridTextColumn Header="Art ID" Binding="{Binding ArtId}" Width="90" />
        <DataGridTextColumn Header="Refs" Binding="{Binding InboundReferenceCount}" Width="60" />
        <DataGridCheckBoxColumn Header="Art" Binding="{Binding ArtFound}" Width="55" />
        <DataGridTextColumn Header="Used by" Binding="{Binding UsedBy}" Width="2.2*" />
        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="2.2*" />
        <DataGridTextColumn Header="Art path" Binding="{Binding ArtPath}" Width="1.8*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
