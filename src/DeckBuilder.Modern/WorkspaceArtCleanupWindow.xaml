<Window x:Class="DeckBuilder.Modern.WorkspaceArtCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Art Cleanup"
        Width="1320" Height="760" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Art Cleanup" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Shows byte-identical TDX files from the unpacked workspace. Review the image and path, then choose which duplicate copies to remove. Nothing is deleted automatically."
                 Margin="0,4,0,10" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBox x:Name="SearchBox" MinWidth="340"
               ToolTip="Search art filename, folder or duplicate group"
               TextChanged="Filter_Changed" />
      <Button DockPanel.Dock="Right" Content="Rescan" Click="Rescan_Click" />
      <Button DockPanel.Dock="Right" Content="Clear marks" Click="ClearMarks_Click" Margin="0,0,8,0" />
      <Button DockPanel.Dock="Right" Content="Mark duplicates (keep one)" Click="MarkDuplicates_Click" Margin="0,0,8,0" />
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="380" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="ArtGrid" Grid.Column="0" AutoGenerateColumns="False"
                CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                SelectionChanged="ArtGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" />
          <DataGridTextColumn Header="Group" Binding="{Binding GroupNumber}" Width="62" IsReadOnly="True" />
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.2*" IsReadOnly="True" />
          <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="1.2*" IsReadOnly="True" />
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" IsReadOnly="True" />
          <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="2*" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock x:Name="PreviewTitle" Text="Select duplicate art" FontSize="17"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewSubtitle" Margin="0,4,0,10" Opacity="0.65"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1" Background="#22000000" CornerRadius="5" Padding="8">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="PreviewPlaceholder" Text="No preview"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="PreviewInfo" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewPath" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="Delete marked…"
              Click="DeleteMarked_Click" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
