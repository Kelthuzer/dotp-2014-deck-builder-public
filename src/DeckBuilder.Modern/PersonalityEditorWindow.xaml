<Window x:Class="DeckBuilder.Modern.PersonalityEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Custom AI personality"
        Width="720"
        Height="590"
        MinWidth="650"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="165" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="10" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Display name" VerticalAlignment="Center" />
        <TextBox x:Name="DisplayNameBox" Grid.Column="1" Grid.ColumnSpan="2" />

        <TextBlock Grid.Row="2" Text="Personality XML" VerticalAlignment="Center" />
        <TextBox x:Name="FileNameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="2" Grid.Column="2" Content="Regenerate" MinWidth="92" Click="Regenerate_Click" />

        <TextBlock Grid.Row="4" Text="Name tag" VerticalAlignment="Center" />
        <TextBox x:Name="NameTagBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" />

        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" FontWeight="SemiBold" Text="Installed personality assets" />

        <TextBlock Grid.Row="8" Text="Full avatar" VerticalAlignment="Center" />
        <TextBox x:Name="LargeAvatarBox" Grid.Row="8" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="8" Grid.Column="2" Content="Browse…" MinWidth="92" Click="LargeAvatarBrowse_Click" />

        <TextBlock Grid.Row="10" Text="Small avatar" VerticalAlignment="Center" />
        <TextBox x:Name="SmallAvatarBox" Grid.Row="10" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="10" Grid.Column="2" Content="Browse…" MinWidth="92" Click="SmallAvatarBrowse_Click" />

        <TextBlock Grid.Row="12" Text="Locked avatar" VerticalAlignment="Center" />
        <TextBox x:Name="LockedAvatarBox" Grid.Row="12" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="12" Grid.Column="2" Content="Browse…" MinWidth="92" Click="LockedAvatarBrowse_Click" />

        <TextBlock Grid.Row="14" Text="Lobby/backplate" VerticalAlignment="Center" />
        <TextBox x:Name="LobbyImageBox" Grid.Row="14" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="14" Grid.Column="2" Content="Browse…" MinWidth="92" Click="LobbyImageBrowse_Click" />

        <TextBlock Grid.Row="16" Text="Music mix" VerticalAlignment="Center" />
        <TextBox x:Name="MusicBox" Grid.Row="16" Grid.Column="1" Margin="0,0,8,0" />
        <Button Grid.Row="16" Grid.Column="2" Content="Browse…" MinWidth="92" Click="MusicBrowse_Click" />
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Foreground="#FF666666" TextWrapping="Wrap" Margin="0,0,16,0"
                 Text="This creates a separate personality XML in the exported WAD. Built-in game files are never modified." />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
        <Button Content="Use custom" IsDefault="True" MinWidth="100" Click="Apply_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
