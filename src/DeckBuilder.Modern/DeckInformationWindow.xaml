<Window x:Class="DeckBuilder.Modern.DeckInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck information"
        Width="760"
        Height="820"
        MinWidth="700"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="18">
        <GroupBox Header="Deck metadata" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="155" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Name" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" MinWidth="390" />

            <TextBlock Grid.Row="2" Text="Description" VerticalAlignment="Top" Margin="0,4,0,0" />
            <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1"
                     Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="4" Text="Availability" VerticalAlignment="Center" />
            <ComboBox x:Name="AvailabilityBox" Grid.Row="4" Grid.Column="1" Width="210" HorizontalAlignment="Left">
              <ComboBoxItem Content="Always available" />
              <ComboBoxItem Content="Locked / unlockable" />
              <ComboBoxItem Content="Never available" />
            </ComboBox>

            <TextBlock Grid.Row="6" Text="Current deck UID" VerticalAlignment="Center" />
            <TextBlock x:Name="UidText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />

            <TextBlock Grid.Row="8" Text="Content pack" VerticalAlignment="Center" />
            <TextBlock x:Name="ContentPackText" Grid.Row="8" Grid.Column="1" TextWrapping="Wrap" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Game references" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="155" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="8" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Personality ID" VerticalAlignment="Center" />
            <TextBox x:Name="PersonalityBox" Grid.Column="1" Margin="0,0,8,0"
                     ToolTip="DotP AI personality XML filename used by the deck." />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="PersonalityBrowseButton" Content="Browse…" MinWidth="84" Margin="0,0,6,0"
                      Click="PersonalityBrowse_Click" />
              <Button x:Name="PersonalityEditButton" Content="Edit copy…" MinWidth="92"
                      Click="PersonalityEdit_Click" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Deck-box image" VerticalAlignment="Center" />
            <TextBox x:Name="DeckBoxImageBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,0"
                     ToolTip="DotP deck_box_image identifier." />
            <Button x:Name="DeckBoxImageBrowseButton" Grid.Row="2" Grid.Column="2" Content="Browse…"
                    MinWidth="84" Click="DeckBoxImageBrowse_Click" />

            <TextBlock Grid.Row="4" Text="Locked image" VerticalAlignment="Center" />
            <TextBox x:Name="DeckBoxImageLockedBox" Grid.Row="4" Grid.Column="1" Margin="0,0,8,0"
                     ToolTip="DotP deck_box_image_locked identifier." />
            <Button x:Name="DeckBoxImageLockedBrowseButton" Grid.Row="4" Grid.Column="2" Content="Browse…"
                    MinWidth="84" Click="DeckBoxImageLockedBrowse_Click" />

            <TextBlock Grid.Row="6" Grid.ColumnSpan="3"
                       Foreground="#FF555555" TextWrapping="Wrap"
                       Text="Browse uses installed game data. Edit copy creates a separate custom personality XML for this project; built-in WAD files are never modified." />
          </Grid>
        </GroupBox>

        <GroupBox Header="Colour override" Margin="0,0,0,12">
          <StackPanel Margin="12">
            <CheckBox x:Name="ColourOverrideBox"
                      Content="Override colours shown on the in-game deck selection screen"
                      Checked="ColourOverrideBox_Changed"
                      Unchecked="ColourOverrideBox_Changed" />
            <UniformGrid x:Name="ColourOptionsPanel" Columns="5" Margin="22,10,0,4">
              <CheckBox x:Name="OverrideBlackBox" Content="Black" />
              <CheckBox x:Name="OverrideBlueBox" Content="Blue" />
              <CheckBox x:Name="OverrideGreenBox" Content="Green" />
              <CheckBox x:Name="OverrideRedBox" Content="Red" />
              <CheckBox x:Name="OverrideWhiteBox" Content="White" />
            </UniformGrid>
            <TextBlock x:Name="DetectedColoursText" Margin="22,5,0,0"
                       Foreground="#FF666666" TextWrapping="Wrap" />
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Deck statistics" Margin="0,0,0,12">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="155" />
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="10" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Creature size" VerticalAlignment="Center" />
            <TextBox x:Name="CreatureSizeBox" Grid.Column="1" />
            <TextBlock Grid.Column="3" Text="Deck speed" VerticalAlignment="Center" />
            <TextBox x:Name="DeckSpeedBox" Grid.Column="4" />

            <TextBlock Grid.Row="2" Text="Flexibility" VerticalAlignment="Center" />
            <TextBox x:Name="FlexibilityBox" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Synergy" VerticalAlignment="Center" />
            <TextBox x:Name="SynergyBox" Grid.Row="2" Grid.Column="4" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Land configuration">
          <Grid Margin="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="95" />
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="95" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="9" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="9" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="9" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Ignore CMC over" VerticalAlignment="Center" />
            <TextBox x:Name="IgnoreCmcOverBox" Grid.Column="1" ToolTip="-1 disables the cutoff." />
            <TextBlock Grid.Column="3" Text="Minimum Forests" VerticalAlignment="Center" />
            <TextBox x:Name="MinForestsBox" Grid.Column="4" />

            <TextBlock Grid.Row="2" Text="Minimum Islands" VerticalAlignment="Center" />
            <TextBox x:Name="MinIslandsBox" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="2" Grid.Column="3" Text="Minimum Mountains" VerticalAlignment="Center" />
            <TextBox x:Name="MinMountainsBox" Grid.Row="2" Grid.Column="4" />

            <TextBlock Grid.Row="4" Text="Minimum Plains" VerticalAlignment="Center" />
            <TextBox x:Name="MinPlainsBox" Grid.Row="4" Grid.Column="1" />
            <TextBlock Grid.Row="4" Grid.Column="3" Text="Minimum Swamps" VerticalAlignment="Center" />
            <TextBox x:Name="MinSwampsBox" Grid.Row="4" Grid.Column="4" />

            <TextBlock Grid.Row="6" Text="Spells that count as land" VerticalAlignment="Center" />
            <TextBox x:Name="SpellsAsLandBox" Grid.Row="6" Grid.Column="1" />
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Background="#FFFAFAFA">
      <Grid Margin="18,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Foreground="#FF666666" TextWrapping="Wrap" Margin="0,0,16,0"
                   Text="Changes are stored in the current .dotpdeck project and exported XML/WAD." />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
          <Button Content="Apply" IsDefault="True" MinWidth="88" Click="Apply_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
