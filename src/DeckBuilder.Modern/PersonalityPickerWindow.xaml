<Window x:Class="DeckBuilder.Modern.PersonalityPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose AI personality"
        Width="900"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center"
             TextChanged="SearchBox_TextChanged" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="PersonalityGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                SelectionChanged="PersonalityGrid_SelectionChanged"
                MouseDoubleClick="PersonalityGrid_MouseDoubleClick">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.4*" />
          <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="1.1*" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" BorderBrush="#FFD0D0D0" BorderThickness="1" Background="#FFF4F4F4">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid>
            <Image x:Name="PreviewImage" Stretch="Uniform" />
            <TextBlock x:Name="PreviewMessage" Text="Select a personality"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#FF666666" TextWrapping="Wrap" TextAlignment="Center" />
          </Grid>
          <TextBlock x:Name="DetailsText" Grid.Row="1" Margin="0,10,0,0"
                     Foreground="#FF555555" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
        <Button x:Name="ChooseButton" Content="Choose" IsDefault="True" MinWidth="88"
                IsEnabled="False" Click="Choose_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
