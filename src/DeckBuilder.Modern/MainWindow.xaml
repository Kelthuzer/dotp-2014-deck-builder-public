<Window x:Class="DeckBuilder.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeckBuilder.Modern"
        Title="DotP 2014 Deck Builder — Modern"
        Width="1500" Height="900" MinWidth="1220" MinHeight="700"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New project" InputGestureText="Ctrl+N" Click="NewProject_Click" />
        <MenuItem Header="Create from existing _game deck…" Click="CreateFromExistingSource_Click" />
        <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OpenProject_Click" />
        <MenuItem Header="_Save project" InputGestureText="Ctrl+S" Click="SaveProject_Click" />
        <MenuItem Header="Save project _as…" Click="SaveProjectAs_Click" />
        <Separator />
        <MenuItem Header="Import deck _XML…" Click="ImportDeckXml_Click" />
        <MenuItem Header="Export deck X_ML…" Click="ExportDeckXml_Click" />
        <MenuItem Header="Export game _WAD…" Click="ExportWorkspaceAwareWad_Click" />
        <Separator />
        <MenuItem Header="E_xit" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="_Deck">
        <MenuItem Header="Deck _information…" Click="DeckInformation_Click" />
        <Separator />
        <MenuItem Header="Deck _library…" Click="DeckLibrary_Click" />
      </MenuItem>
      <MenuItem Header="_Game data">
        <MenuItem Header="Load Magic 2014 _folder…" Click="LoadGameFolder_Click" />
        <MenuItem Header="_Reload current folder" Click="ReloadGameFolder_Click" />
        <Separator />
        <MenuItem Header="Load unpacked _workspace…" Click="LoadWorkspace_Click" />
        <MenuItem Header="Reload unpacked w_orkspace" Click="ReloadWorkspace_Click" />
        <Separator />
        <MenuItem Header="_WAD Workshop…" Click="WadWorkshop_Click" />
        <MenuItem Header="Build cards/decks from _unpacked…" Click="BuildFromUnpackedContent_Click" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About modern build" Click="About_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready. Load the Magic 2014 game folder to begin." />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="CountText" Text="Cards: 0 | Deck: 0 | Unlocks: 0 + 0" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" MinWidth="390" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="285" MinWidth="235" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="1.4*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Text="Card catalog" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8" />
          <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,8"
                   ToolTip="Search name, filename, type, set or artist"
                   TextChanged="SearchBox_TextChanged" />
          <DataGrid x:Name="AvailableCardsGrid" Grid.Row="2" ItemsSource="{Binding AvailableCards}"
                    IsReadOnly="True" MouseDoubleClick="AvailableCardsGrid_MouseDoubleClick"
                    SelectionChanged="CardGrid_SelectionChanged"
                    PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Grid_PreviewMouseMove">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Card" Binding="{Binding LocalizedName}" Width="1.45*" />
              <DataGridTemplateColumn Header="Cost" Width="70" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:ManaCostPresenter Cost="{Binding CastingCost}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Type" Binding="{Binding TypeLine}" Width="1.2*" />
              <DataGridTextColumn Header="Set" Binding="{Binding Expansion}" Width="72" />
              <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="1.15*" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="3" Margin="0,7,0,0">
            <Button Content="Add to deck" Click="AddToDeck_Click" />
            <Button Content="Add unlock" Click="AddRegularUnlock_Click" />
            <Button Content="Add promo" Click="AddPromoUnlock_Click" />
          </WrapPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="PreviewName" Text="Card preview" FontSize="18" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="2,0,0,10" />
          <Border Grid.Row="1" Background="#FFF4F6F8" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="5">
            <Grid>
              <Viewbox x:Name="CardPreviewViewbox" Stretch="Uniform" Visibility="Collapsed">
                <Canvas Width="356" Height="512" Background="Black" ClipToBounds="True">
                  <Rectangle x:Name="PreviewFrameFallback" Width="356" Height="512" Fill="#FFD6D3C9" />
                  <Image x:Name="PreviewFrameImage" Width="356" Height="512" Stretch="Fill"
                         RenderOptions.BitmapScalingMode="HighQuality" Panel.ZIndex="1" />
                  <Image x:Name="CardPreviewImage" Canvas.Left="16" Canvas.Top="47" Width="324" Height="238"
                         Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" Panel.ZIndex="2" />

                  <TextBlock x:Name="PreviewCardTitle" Canvas.Left="12" Canvas.Top="13" Width="278" Height="25"
                             FontFamily="Georgia" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                             Foreground="Black" Panel.ZIndex="3" />
                  <StackPanel x:Name="PreviewManaPanel" Canvas.Top="8" Orientation="Horizontal"
                              Panel.ZIndex="4" />
                  <TextBlock x:Name="PreviewCardTypeLine" Canvas.Left="14" Canvas.Top="294" Width="286" Height="23"
                             FontFamily="Georgia" FontSize="14" TextTrimming="CharacterEllipsis"
                             Foreground="Black" Panel.ZIndex="3" />
                  <Image x:Name="PreviewRarityImage" Canvas.Left="302" Canvas.Top="292" Width="50" Height="25"
                         Stretch="Uniform" Panel.ZIndex="3" />

                  <TextBlock x:Name="PreviewRulesText" Canvas.Left="15" Canvas.Top="324" Width="324" Height="150"
                             FontFamily="Georgia" FontSize="13" LineHeight="16" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" Foreground="Black" Panel.ZIndex="3" />

                  <Image x:Name="PreviewPowerBoxImage" Canvas.Left="245" Canvas.Top="453" Width="130" Height="65"
                         Stretch="Fill" Panel.ZIndex="3" />
                  <Border x:Name="PreviewPowerBoxFallback" Canvas.Left="277" Canvas.Top="472" Width="66" Height="28"
                          Background="#FFE7DFC9" BorderBrush="#FF3B3128" BorderThickness="1" CornerRadius="9"
                          Panel.ZIndex="3" />
                  <TextBlock x:Name="PreviewPowerText" Canvas.Left="280" Canvas.Top="474" Width="60" Height="23"
                             FontFamily="Georgia" FontSize="17" FontWeight="Bold" TextAlignment="Center"
                             Foreground="Black" Panel.ZIndex="4" />

                  <Image x:Name="PreviewCreditImage" Canvas.Left="10" Canvas.Top="488" Width="34" Height="9"
                         Stretch="Fill" Panel.ZIndex="3" />
                  <TextBlock x:Name="PreviewArtistText" Canvas.Left="42" Canvas.Top="482" Width="230" Height="17"
                             FontFamily="Georgia" FontSize="10" FontWeight="Bold" Foreground="Black"
                             TextTrimming="CharacterEllipsis" Panel.ZIndex="4" />
                </Canvas>
              </Viewbox>
              <TextBlock x:Name="PreviewPlaceholder" Text="Select a card to load its art"
                         TextWrapping="Wrap" TextAlignment="Center" Foreground="#FF555555"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="2,10,2,0">
            <TextBlock x:Name="PreviewType" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewStats" TextWrapping="Wrap" Margin="0,4,0,0" />
            <TextBlock x:Name="PreviewSource" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555" />
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
          </Grid.RowDefinitions>

          <TextBlock Text="Main deck" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8" />
          <DataGrid x:Name="MainDeckGrid" Grid.Row="1" ItemsSource="{Binding MainDeckEntries}"
                    Tag="MainDeck" AllowDrop="True" Drop="SectionGrid_Drop" DragOver="SectionGrid_DragOver"
                    SelectionChanged="CardGrid_SelectionChanged"
                    PreviewKeyDown="SectionGrid_PreviewKeyDown"
                    PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Grid_PreviewMouseMove">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" />
              <DataGridTextColumn Header="Card" Binding="{Binding Card.LocalizedName}" Width="1.4*" IsReadOnly="True" />
              <DataGridTemplateColumn Header="Cost" Width="66" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <local:ManaCostPresenter Cost="{Binding Card.CastingCost}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Reference" Binding="{Binding CardReference}" Width="1.1*" IsReadOnly="True" />
            </DataGrid.Columns>
          </DataGrid>
          <WrapPanel Grid.Row="2" Margin="0,6,0,0">
            <Button Content="+1 copy" Click="AddDeckCopy_Click" />
            <Button Content="Remove" Click="RemoveMain_Click" />
            <Button Content="Move to unlocks" Click="MoveMainToUnlock_Click" />
          </WrapPanel>

          <GridSplitter Grid.Row="3" Height="10" HorizontalAlignment="Stretch" Background="Transparent" />

          <TextBlock Grid.Row="4" Text="Unlock order" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8" />
          <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1*" />
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Regular unlocks" FontWeight="SemiBold" Margin="2,0,0,5" />
            <DataGrid x:Name="RegularUnlocksGrid" Grid.Row="1" ItemsSource="{Binding RegularUnlockEntries}"
                      Tag="RegularUnlocks" AllowDrop="True" Drop="SectionGrid_Drop" DragOver="SectionGrid_DragOver"
                      SelectionChanged="CardGrid_SelectionChanged"
                      PreviewKeyDown="SectionGrid_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Grid_PreviewMouseMove">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding OrderId}" Width="42" IsReadOnly="True" />
                <DataGridTextColumn Header="Card" Binding="{Binding Card.LocalizedName}" Width="1.4*" IsReadOnly="True" />
                <DataGridTextColumn Header="Reference" Binding="{Binding CardReference}" Width="1*" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="2" Margin="0,5,0,0">
              <Button Content="▲" ToolTip="Move up" Click="RegularUp_Click" />
              <Button Content="▼" ToolTip="Move down" Click="RegularDown_Click" />
              <Button Content="Remove" Click="RemoveRegular_Click" />
            </WrapPanel>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <TextBlock Grid.Column="2" Text="Promo unlocks (maximum 10)" FontWeight="SemiBold" Margin="2,0,0,5" />
            <DataGrid x:Name="PromoUnlocksGrid" Grid.Column="2" Grid.Row="1" ItemsSource="{Binding PromoUnlockEntries}"
                      Tag="PromoUnlocks" AllowDrop="True" Drop="SectionGrid_Drop" DragOver="SectionGrid_DragOver"
                      SelectionChanged="CardGrid_SelectionChanged"
                      PreviewKeyDown="SectionGrid_PreviewKeyDown"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Grid_PreviewMouseMove">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding OrderId}" Width="42" IsReadOnly="True" />
                <DataGridTextColumn Header="Card" Binding="{Binding Card.LocalizedName}" Width="1.4*" IsReadOnly="True" />
                <DataGridTextColumn Header="Reference" Binding="{Binding CardReference}" Width="1*" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Column="2" Grid.Row="2" Margin="0,5,0,0">
              <Button Content="▲" ToolTip="Move up" Click="PromoUp_Click" />
              <Button Content="▼" ToolTip="Move down" Click="PromoDown_Click" />
              <Button Content="Remove" Click="RemovePromo_Click" />
            </WrapPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
