<Window x:Class="DeckBuilder.Modern.ExistingDeckPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create from existing game deck"
        Width="1040" Height="600" MinWidth="800" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="Choose an installed Magic 2014 deck to use as a starting point. The original WAD will not be changed."
               TextWrapping="Wrap" Margin="0,0,0,10" />
    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10"
             ToolTip="Search deck name, filename, UID or WAD"
             TextChanged="SearchBox_TextChanged" />

    <DataGrid x:Name="DeckGrid" Grid.Row="2" IsReadOnly="True"
              AutoGenerateColumns="False" SelectionMode="Single"
              SelectionUnit="FullRow" SelectionChanged="DeckGrid_SelectionChanged"
              MouseDoubleClick="DeckGrid_MouseDoubleClick">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow">
          <Setter Property="ToolTip" Value="{Binding MissingReferencesText}" />
        </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
        <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="80" />
        <DataGridTextColumn Header="Deck" Binding="{Binding DisplayName}" Width="1.35*" />
        <DataGridTextColumn Header="Filename" Binding="{Binding FileName}" Width="1.2*" />
        <DataGridTextColumn Header="Cards" Binding="{Binding CardCount}" Width="70" />
        <DataGridTextColumn Header="Unlocks" Binding="{Binding RegularUnlockCount}" Width="75" />
        <DataGridTextColumn Header="Promo" Binding="{Binding PromoUnlockCount}" Width="65" />
        <DataGridTextColumn Header="Missing" Binding="{Binding MissingCardCount}" Width="70" />
        <DataGridTextColumn Header="WAD / source" Binding="{Binding Source}" Width="1.15*" />
      </DataGrid.Columns>
    </DataGrid>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="New deck name:" VerticalAlignment="Center" Margin="0,0,10,0" />
      <TextBox x:Name="NewNameBox" Grid.Column="1" MinWidth="260" />
    </Grid>

    <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" />
      <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="Create copy"
              IsDefault="True" IsEnabled="False" Click="Create_Click" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
