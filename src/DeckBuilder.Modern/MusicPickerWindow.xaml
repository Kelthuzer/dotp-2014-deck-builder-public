<Window x:Class="DeckBuilder.Modern.MusicPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose music mix"
        Width="520"
        Height="540"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center"
             TextChanged="SearchBox_TextChanged" />
    <ListBox x:Name="MusicList" Grid.Row="2"
             SelectionChanged="MusicList_SelectionChanged"
             MouseDoubleClick="MusicList_MouseDoubleClick" />

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
        <Button x:Name="ChooseButton" Content="Choose" IsDefault="True" MinWidth="88"
                IsEnabled="False" Click="Choose_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
