<Window x:Class="DeckBuilder.Modern.WorkspaceVariantResolverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resolve WAD variants"
        Width="1320" Height="800" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="Choose between different card / deck variants" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FF555555"
                   Text="These extracted versions contain different payloads for the same in-game path. Nothing is silently discarded: choose the version you want. Byte-identical copies do not require a choice." />
      </StackPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StatusBarItem><TextBlock x:Name="StatusText" /></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="Conflicts requiring a choice" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,8" />
          <DataGrid x:Name="ConflictsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" SelectionChanged="ConflictsGrid_SelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="88" />
              <DataGridTextColumn Header="Card / file" Binding="{Binding DisplayName}" Width="1.5*" />
              <DataGridTextColumn Header="#" Binding="{Binding VariantCount}" Width="42" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="260" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="ConflictTitle" Text="Select a conflict" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,8" />

          <DataGrid x:Name="VariantsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" SelectionChanged="VariantsGrid_SelectionChanged"
                    MouseDoubleClick="VariantsGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Suggested" Binding="{Binding SuggestedText}" Width="72" />
              <DataGridTextColumn Header="Card" Binding="{Binding Variant.DisplayName}" Width="1.25*" />
              <DataGridTextColumn Header="Reference" Binding="{Binding Variant.Reference}" Width="1.15*" />
              <DataGridTextColumn Header="Cost" Binding="{Binding Variant.CastingCost}" Width="64" />
              <DataGridTextColumn Header="Type" Binding="{Binding Variant.TypeLine}" Width="1.15*" />
              <DataGridTextColumn Header="P/T" Binding="{Binding Variant.PowerToughness}" Width="55" />
              <DataGridTextColumn Header="ARTID" Binding="{Binding Variant.ArtId}" Width="100" />
              <DataGridTextColumn Header="Version" Binding="{Binding Variant.PackageName}" Width="120" />
              <DataGridTextColumn Header="WAD" Binding="{Binding Variant.WadName}" Width="150" />
              <DataGridTextColumn Header="Order" Binding="{Binding Variant.WadOrder}" Width="55" />
            </DataGrid.Columns>
          </DataGrid>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="250" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="#FFF4F6F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5">
              <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="PreviewMessage" Text="Select a variant" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#FF666666" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
              </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailReference" Margin="0,4,0,0" FontFamily="Consolas" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailStats" Margin="0,7,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailExpansion" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailArt" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailSource" Margin="0,7,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailRules" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailPath" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11"
                           Foreground="#FF666666" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <Button Content="Use suggested for all unresolved" Padding="14,6" Click="UseSuggestedAll_Click" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="UseVariantButton" Content="Use selected variant" Padding="16,6" Click="UseVariant_Click" IsEnabled="False" />
              <Button x:Name="ContinueButton" Content="Continue build" Padding="18,6" Margin="8,0,0,0"
                      Click="Continue_Click" IsEnabled="False" />
              <Button Content="Cancel" Padding="14,6" Margin="8,0,0,0" Click="Cancel_Click" />
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
