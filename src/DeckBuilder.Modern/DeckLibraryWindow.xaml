<Window x:Class="DeckBuilder.Modern.DeckLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck library"
        Width="1260" Height="700" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Deck library" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Open any deck found in the loaded game/workspace for editing, or create an independent copy as a new project."
                 Margin="0,4,0,10" TextWrapping="Wrap" Foreground="#FF475569" />
    </StackPanel>

    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,10"
             ToolTip="Search game name, technical name, UID or source"
             TextChanged="SearchBox_TextChanged" />

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="300" MinWidth="250" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="DeckGrid" Grid.Column="0" IsReadOnly="True"
                AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
                SelectionChanged="DeckGrid_SelectionChanged" MouseDoubleClick="DeckGrid_MouseDoubleClick">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding MissingReferencesText}" />
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="Game name" Binding="{Binding FriendlyName}" Width="1.55*" />
          <DataGridTextColumn Header="Technical" Binding="{Binding TechnicalName}" Width="1.25*" />
          <DataGridTextColumn Header="UID" Binding="{Binding Uid}" Width="78" />
          <DataGridTextColumn Header="Cards" Binding="{Binding CardCount}" Width="68" />
          <DataGridTextColumn Header="Unlocks" Binding="{Binding RegularUnlockCount}" Width="72" />
          <DataGridTextColumn Header="Promo" Binding="{Binding PromoUnlockCount}" Width="62" />
          <DataGridTextColumn Header="Missing" Binding="{Binding MissingCardCount}" Width="66" />
          <DataGridTextColumn Header="WAD / source" Binding="{Binding Source}" Width="1.2*" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock x:Name="PreviewGameName" Text="Select a deck" FontSize="18"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewTechnicalName" Margin="0,4,0,10" Opacity="0.65"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1" Background="#22000000" CornerRadius="5" Padding="8">
            <Grid>
              <Image x:Name="DeckCoverPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="DeckCoverPlaceholder" Text="No deck cover"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.55" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="PreviewDeckBoxId" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewStats" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewSource" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" />
      <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Open for editing"
              IsDefault="True" IsEnabled="False" Click="Open_Click" />
      <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Create copy"
              IsEnabled="False" Click="Copy_Click" Margin="0,0,8,0" />
      <Button x:Name="CleanupButton" Visibility="Collapsed" IsEnabled="False" />
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
