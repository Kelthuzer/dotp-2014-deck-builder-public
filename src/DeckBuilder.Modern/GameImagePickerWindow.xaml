<Window x:Class="DeckBuilder.Modern.GameImagePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose game image"
        Width="760"
        Height="600"
        MinWidth="620"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="8" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center"
                 TextChanged="SearchBox_TextChanged" />
        <ListBox x:Name="ImageList" Grid.Row="2"
                 SelectionChanged="ImageList_SelectionChanged"
                 MouseDoubleClick="ImageList_MouseDoubleClick" />
      </Grid>

      <Border Grid.Column="2" BorderBrush="#FFD0D0D0" BorderThickness="1" Background="#FFF4F4F4">
        <Grid Margin="10">
          <Image x:Name="PreviewImage" Stretch="Uniform" />
          <TextBlock x:Name="PreviewMessage" Text="Select an image"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="#FF666666" TextWrapping="Wrap" TextAlignment="Center" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF666666" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
        <Button x:Name="ChooseButton" Content="Choose" IsDefault="True" MinWidth="88"
                IsEnabled="False" Click="Choose_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
