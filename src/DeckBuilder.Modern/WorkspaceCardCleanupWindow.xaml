<Window x:Class="DeckBuilder.Modern.WorkspaceCardCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Card Cleanup"
        Width="1500" Height="840" MinWidth="1120" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Card Cleanup" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Review loose CARD XML definitions in the unpacked workspace. The window shows which decks use each card and its related illustration TDX. Deleting a card removes only the selected loose XML definition; art is never deleted automatically."
                 Margin="0,4,0,10" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0"
               ToolTip="Search card name, English name, filename, type, set, deck usage or path"
               TextChanged="SearchBox_TextChanged" />
      <CheckBox x:Name="UnusedOnlyCheckBox" Grid.Column="2" Content="Unused only"
                VerticalAlignment="Center" Checked="UnusedOnly_Changed" Unchecked="UnusedOnly_Changed" />
      <Button Grid.Column="4" Content="Mark duplicates (keep one)" Click="MarkDuplicates_Click" />
      <Button Grid.Column="6" Content="Clear marks" Click="ClearMarks_Click" />
      <Button Grid.Column="8" Content="Rescan" Click="Rescan_Click" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="430" MinWidth="350" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="CardGrid" Grid.Column="0" AutoGenerateColumns="False"
                CanUserAddRows="False" IsReadOnly="False"
                SelectionMode="Extended" SelectionUnit="FullRow"
                SelectionChanged="CardGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" />
          <DataGridTextColumn Header="Used" Binding="{Binding UsageText}" Width="62" IsReadOnly="True" />
          <DataGridTextColumn Header="Decks" Binding="{Binding UsedDeckCount}" Width="62" IsReadOnly="True" />
          <DataGridTextColumn Header="Dup" Binding="{Binding GroupText}" Width="52" IsReadOnly="True" />
          <DataGridTextColumn Header="Card" Binding="{Binding DisplayName}" Width="1.45*" IsReadOnly="True" />
          <DataGridTextColumn Header="English" Binding="{Binding EnglishName}" Width="1.05*" IsReadOnly="True" />
          <DataGridTextColumn Header="Type" Binding="{Binding TypeLine}" Width="1.1*" IsReadOnly="True" />
          <DataGridTextColumn Header="Set" Binding="{Binding Expansion}" Width="76" IsReadOnly="True" />
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.05*" IsReadOnly="True" />
          <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="1.25*" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2.2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1.15*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.8*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="PreviewTitle" Text="Select a card" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewSubtitle" Margin="0,4,0,10" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Background="#22000000" CornerRadius="5" Padding="8">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="PreviewPlaceholder" Text="No preview"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Margin="0,10,0,5">
            <TextBlock x:Name="PreviewInfo" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewPath" Margin="0,5,0,0" Opacity="0.65" TextWrapping="Wrap" />
            <TextBlock Text="Used by decks" FontWeight="SemiBold" Margin="0,9,0,4" />
          </StackPanel>
          <ListBox x:Name="UsageList" Grid.Row="3" MinHeight="70" />
          <TextBlock Grid.Row="4" Text="Related resources" FontWeight="SemiBold" Margin="0,9,0,4" />
          <ListBox x:Name="ResourceList" Grid.Row="5" MinHeight="55" />
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" />
      <Button DockPanel.Dock="Right" Content="Delete marked…" Click="DeleteSelected_Click" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
