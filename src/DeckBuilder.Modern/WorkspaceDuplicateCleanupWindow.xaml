<Window x:Class="DeckBuilder.Modern.WorkspaceDuplicateCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deck Cleanup"
        Width="1480" Height="800" MinWidth="1120" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Deck Cleanup" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Review loose-workspace decks, their cards and unlock sections before deleting them. Duplicate tools are kept separately and nothing is removed automatically."
                 Margin="0,4,0,10" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox x:Name="CategoryBox" Grid.Column="0" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="All decks" Tag="AllDecks" IsSelected="True" />
        <ComboBoxItem Content="Duplicate deck XML" Tag="DuplicateDecks" />
        <ComboBoxItem Content="Duplicate TDX art" Tag="DuplicateArt" />
      </ComboBox>

      <TextBox x:Name="DeckSearchBox" Grid.Column="2"
               ToolTip="Search deck name, technical filename, UID or path"
               TextChanged="Filter_Changed" />
      <TextBox x:Name="CardSearchBox" Grid.Column="4"
               ToolTip="Search cards contained in main deck, unlocks or promo unlocks"
               TextChanged="Filter_Changed" />

      <ComboBox x:Name="SortBox" Grid.Column="6" SelectionChanged="Filter_Changed"
                ToolTip="Sort deck list">
        <ComboBoxItem Content="Game name" Tag="GameName" IsSelected="True" />
        <ComboBoxItem Content="UID" Tag="Uid" />
        <ComboBoxItem Content="Cards" Tag="Cards" />
        <ComboBoxItem Content="Promo unlocks" Tag="Promo" />
        <ComboBoxItem Content="File" Tag="File" />
      </ComboBox>

      <CheckBox x:Name="PromoOnlyCheck" Grid.Column="8" Content="Promo only"
                VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"
                ToolTip="Show only decks that have promo unlock cards" />

      <Button Grid.Column="10" Content="Mark duplicates (keep one)" Click="MarkDuplicates_Click" />
      <Button Grid.Column="12" Content="Clear marks" Click="ClearMarks_Click" />
      <Button Grid.Column="14" Content="Rescan" Click="Rescan_Click" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="400" MinWidth="330" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="DuplicateGrid" Grid.Column="0" AutoGenerateColumns="False"
                CanUserAddRows="False" CanUserSortColumns="False"
                SelectionMode="Extended" SelectionUnit="FullRow"
                SelectionChanged="DuplicateGrid_SelectionChanged">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" />
          <DataGridTextColumn Header="Dup" Binding="{Binding GroupText}" Width="52" IsReadOnly="True" />
          <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="64" IsReadOnly="True" />
          <DataGridTextColumn Header="Game name" Binding="{Binding DisplayGameName}" Width="1.35*" IsReadOnly="True" />
          <DataGridTextColumn Header="UID" Binding="{Binding UidText}" Width="74" IsReadOnly="True" />
          <DataGridTextColumn Header="Cards" Binding="{Binding CardsText}" Width="62" IsReadOnly="True" />
          <DataGridTextColumn Header="Unlocks" Binding="{Binding UnlocksText}" Width="70" IsReadOnly="True" />
          <DataGridTextColumn Header="Promo" Binding="{Binding PromoText}" Width="62" IsReadOnly="True" />
          <DataGridTextColumn Header="Missing" Binding="{Binding MissingText}" Width="66" IsReadOnly="True" />
          <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.15*" IsReadOnly="True" />
          <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="1.8*" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="230" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock x:Name="PreviewTitle" Text="Select a deck or art file" FontSize="17"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="PreviewSubtitle" Margin="0,4,0,10" Opacity="0.65"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1" Background="#22000000" CornerRadius="5" Padding="8">
            <Grid>
              <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="PreviewPlaceholder" Text="No preview"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
          </Border>

          <TextBlock x:Name="PreviewInfo" Grid.Row="2" Margin="0,10,0,8"
                     TextWrapping="Wrap" />

          <TabControl x:Name="DeckSections" Grid.Row="3">
            <TabItem x:Name="MainTab" Header="Main">
              <ListBox x:Name="MainDeckList" />
            </TabItem>
            <TabItem x:Name="UnlockTab" Header="Unlocks">
              <ListBox x:Name="UnlockList" />
            </TabItem>
            <TabItem x:Name="PromoTab" Header="Promo">
              <ListBox x:Name="PromoList" />
            </TabItem>
          </TabControl>

          <TextBlock x:Name="PreviewPath" Grid.Row="4" Margin="0,8,0,0"
                     Opacity="0.65" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" />
      <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete marked…"
              Click="DeleteSelected_Click" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
