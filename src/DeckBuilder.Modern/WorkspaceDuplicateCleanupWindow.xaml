<Window x:Class="DeckBuilder.Modern.WorkspaceDuplicateCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workspace duplicate cleanup"
        Width="1220" Height="720" MinWidth="920" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Manual duplicate cleanup" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="Scans the unpacked workspace for byte-identical deck XML files and TDX art. Nothing is removed automatically. Select exactly what you want to delete."
                 Margin="0,4,0,10" TextWrapping="Wrap" Opacity="0.75" />
    </StackPanel>

    <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <ComboBox x:Name="CategoryBox" Width="180" SelectionChanged="Filter_Changed">
        <ComboBoxItem Content="Decks + art" Tag="All" IsSelected="True" />
        <ComboBoxItem Content="Deck XML only" Tag="Deck" />
        <ComboBoxItem Content="TDX art only" Tag="Art" />
      </ComboBox>
      <TextBox x:Name="SearchBox" Margin="8,0,0,0" MinWidth="280"
               ToolTip="Filter filename or path" TextChanged="Filter_Changed" />
      <Button DockPanel.Dock="Right" Content="Rescan" Click="Rescan_Click" />
      <Button DockPanel.Dock="Right" Content="Clear marks" Click="ClearMarks_Click" Margin="0,0,8,0" />
      <Button DockPanel.Dock="Right" Content="Mark duplicates (keep one)" Click="MarkDuplicates_Click" Margin="0,0,8,0" />
    </DockPanel>

    <DataGrid x:Name="DuplicateGrid" Grid.Row="2" AutoGenerateColumns="False"
              CanUserAddRows="False" SelectionMode="Extended" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="Delete" Binding="{Binding Delete, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="64" />
        <DataGridTextColumn Header="Group" Binding="{Binding GroupNumber}" Width="62" IsReadOnly="True" />
        <DataGridTextColumn Header="Type" Binding="{Binding Category}" Width="76" IsReadOnly="True" />
        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="1.15*" IsReadOnly="True" />
        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="88" IsReadOnly="True" />
        <DataGridTextColumn Header="Path" Binding="{Binding RelativePath}" Width="2.2*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock x:Name="SummaryText" VerticalAlignment="Center" />
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" />
      <Button x:Name="DeleteButton" DockPanel.Dock="Right" Content="Delete selected…"
              Click="DeleteSelected_Click" Margin="0,0,8,0" />
    </DockPanel>
  </Grid>
</Window>
